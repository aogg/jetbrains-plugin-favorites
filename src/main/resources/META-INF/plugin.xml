<idea-plugin>
    <id>com.aogg.favorites</id>
    <name>Favorites</name>
    <version>1.0.3</version>
    <vendor email="aogg@example.com" url="https://github.com/aogg">aogg</vendor>

    <description><![CDATA[
    收藏插件 - 提供代码行、文件和文件夹的收藏功能，支持匿名收藏和助记符收藏。
    功能包括：
    - 匿名收藏：无限制数量的收藏，在编辑器行号区域显示书签图标
    - 助记符收藏：使用数字（0-9）或字母（A-Z）作为标识符，最多36个
    - 收藏管理工具窗口：统一管理所有收藏
    - 快速访问：弹出窗口快速跳转到收藏位置
    ]]></description>

    <change-notes><![CDATA[
    1.0.3 - 阶段三：工具窗口
    - 实现 BookmarksToolWindow 工具窗口
    - 实现 BookmarksTree 自定义Tree组件
    - 实现双击跳转功能
    - 实现右键菜单（编辑、删除）
    - 实现 ToggleBookmarksToolWindowAction
    
    1.0.2 - 阶段二：核心功能
    - 实现 BookmarkStorageHelper 持久化存储
    - 实现 AddAnonymousBookmarkAction 添加匿名收藏动作
    - 实现 AddMnemonicBookmarkAction 添加助记符收藏动作
    - 实现 MnemonicSelectorDialog 助记符选择对话框
    - 实现 BookmarkGutterHelper 编辑器图标显示
    - 实现编辑器右键菜单集成
    
    1.0.0 - 初始版本
    - 实现基础收藏功能框架
    ]]></change-notes>

    <!-- 兼容的IDE版本 -->
    <idea-version since-build="233" until-build="242.*"/>

    <!-- 依赖 -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 插件启动活动 -->
        <postStartupActivity implementation="com.aogg.favorites.FavoritesPlugin"/>

        <!-- 工具窗口 -->
        <toolWindow id="Favorites" secondary="true" anchor="bottom" factoryClass="com.aogg.favorites.ui.BookmarksToolWindowFactory" icon="AllIcons.Gutter.Bookmark"/>

        <!-- 编辑器行号区域图标显示 -->
        <codeInsight.lineMarkerProvider language="" implementationClass="com.aogg.favorites.helper.BookmarkGutterHelper"/>

        <!-- 编辑器右键菜单 -->
        <action id="Favorites.AddAnonymousBookmark" class="com.aogg.favorites.action.AddAnonymousBookmarkAction" text="添加匿名收藏">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt F11"/>
        </action>

        <action id="Favorites.AddMnemonicBookmark" class="com.aogg.favorites.action.AddMnemonicBookmarkAction" text="添加助记符收藏">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Favorites.AddAnonymousBookmark"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift F11"/>
        </action>

    </extensions>

    <actions>
        <!-- 全局动作 -->
        <action id="Favorites.AddAnonymousBookmarkGlobal" class="com.aogg.favorites.action.AddAnonymousBookmarkAction" text="添加匿名收藏">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt F11"/>
        </action>

        <action id="Favorites.AddMnemonicBookmarkGlobal" class="com.aogg.favorites.action.AddMnemonicBookmarkAction" text="添加助记符收藏">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift F11"/>
        </action>

        <action id="Favorites.ToggleBookmarksToolWindow" class="com.aogg.favorites.action.ToggleBookmarksToolWindowAction" text="显示/隐藏收藏工具窗口">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt 2"/>
        </action>
    </actions>
</idea-plugin>
