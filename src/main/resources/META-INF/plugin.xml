<idea-plugin>
    <id>com.aogg.favorites</id>
    <name>Favorites</name>
    <version>1.0.10</version>
    <vendor email="aogg@example.com" url="https://github.com/aogg">aogg</vendor>

    <description><![CDATA[
    收藏插件 - 提供代码行、文件和文件夹的收藏功能，支持匿名收藏和助记符收藏。
    功能包括：
    - 匿名收藏：无限制数量的收藏，在编辑器行号区域显示书签图标
    - 助记符收藏：使用数字（0-9）或字母（A-Z）作为标识符，最多36个
    - 收藏管理工具窗口：统一管理所有收藏
    - 快速访问：弹出窗口快速跳转到收藏位置
    ]]></description>

    <change-notes><![CDATA[
    1.0.10 - 小优化
    - 清理编译期 warning（不影响功能）

    1.0.9 - 阶段七：监听器和优化
    - 新增项目级监听器：处理文件/文件夹删除、重命名、移动时的收藏同步与清理
    - 新增编辑器监听器：自动清理无效行收藏（行号超出范围）并刷新显示
    - 性能优化：收藏管理器只加载一次持久化数据；gutter 查询使用行收藏索引避免全量扫描

    1.0.8 - 阶段六：编辑器标签集成
    - 实现编辑器标签页右键菜单集成
    - 实现标签页收藏功能
    - 支持从标签页右键菜单添加匿名收藏和助记符收藏
    
    1.0.5 - 阶段五：项目窗口集成
    - 实现项目窗口右键菜单集成
    - 实现文件/文件夹收藏功能
    - 实现批量添加收藏功能
    - 优化助记符收藏的批量选择提示
    
    1.0.4 - 阶段四：快速访问
    - 实现 BookmarkPopup 快速访问弹出窗口
    - 实现 ShowBookmarksPopupAction 显示收藏弹出窗口动作
    - 实现 JumpToMnemonicBookmarkAction 跳转到助记符收藏动作（36个快捷键）
    - 支持键盘导航和搜索功能
    
    1.0.3 - 阶段三：工具窗口
    - 实现 BookmarksToolWindow 工具窗口
    - 实现 BookmarksTree 自定义Tree组件
    - 实现双击跳转功能
    - 实现右键菜单（编辑、删除）
    - 实现 ToggleBookmarksToolWindowAction
    
    1.0.2 - 阶段二：核心功能
    - 实现 BookmarkStorageHelper 持久化存储
    - 实现 AddAnonymousBookmarkAction 添加匿名收藏动作
    - 实现 AddMnemonicBookmarkAction 添加助记符收藏动作
    - 实现 MnemonicSelectorDialog 助记符选择对话框
    - 实现 BookmarkGutterHelper 编辑器图标显示
    - 实现编辑器右键菜单集成
    
    1.0.0 - 初始版本
    - 实现基础收藏功能框架
    ]]></change-notes>

    <!-- 兼容的IDE版本 -->
    <idea-version since-build="233" until-build="242.*"/>

    <!-- 依赖 -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 插件启动活动 -->
        <postStartupActivity implementation="com.aogg.favorites.FavoritesPlugin"/>

        <!-- 工具窗口 -->
        <toolWindow id="Favorites" secondary="true" anchor="bottom" factoryClass="com.aogg.favorites.ui.BookmarksToolWindowFactory" icon="AllIcons.Gutter.Bookmark"/>

        <!-- 编辑器行号区域图标显示 -->
        <codeInsight.lineMarkerProvider language="" implementationClass="com.aogg.favorites.helper.BookmarkGutterHelper"/>

        <!-- 编辑器右键菜单 -->
        <action id="Favorites.AddAnonymousBookmark" class="com.aogg.favorites.action.AddAnonymousBookmarkAction" text="添加匿名收藏">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt F11"/>
        </action>

        <action id="Favorites.AddMnemonicBookmark" class="com.aogg.favorites.action.AddMnemonicBookmarkAction" text="添加助记符收藏">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Favorites.AddAnonymousBookmark"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift F11"/>
        </action>

        <!-- 项目窗口右键菜单 -->
        <action id="Favorites.AddAnonymousBookmarkProject" class="com.aogg.favorites.action.AddAnonymousBookmarkAction" text="添加匿名收藏">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <action id="Favorites.AddMnemonicBookmarkProject" class="com.aogg.favorites.action.AddMnemonicBookmarkAction" text="添加助记符收藏">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="Favorites.AddAnonymousBookmarkProject"/>
        </action>

        <!-- 编辑器标签页右键菜单 -->
        <action id="Favorites.AddAnonymousBookmarkTab" class="com.aogg.favorites.action.AddAnonymousBookmarkAction" text="添加匿名收藏">
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>

        <action id="Favorites.AddMnemonicBookmarkTab" class="com.aogg.favorites.action.AddMnemonicBookmarkAction" text="添加助记符收藏">
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="Favorites.AddAnonymousBookmarkTab"/>
        </action>

    </extensions>

    <actions>
        <!-- 全局动作 -->
        <action id="Favorites.AddAnonymousBookmarkGlobal" class="com.aogg.favorites.action.AddAnonymousBookmarkAction" text="添加匿名收藏">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt F11"/>
        </action>

        <action id="Favorites.AddMnemonicBookmarkGlobal" class="com.aogg.favorites.action.AddMnemonicBookmarkAction" text="添加助记符收藏">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift F11"/>
        </action>

        <action id="Favorites.ToggleBookmarksToolWindow" class="com.aogg.favorites.action.ToggleBookmarksToolWindowAction" text="显示/隐藏收藏工具窗口">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt 2"/>
        </action>

        <action id="Favorites.ShowBookmarksPopup" class="com.aogg.favorites.action.ShowBookmarksPopupAction" text="显示收藏列表">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift B"/>
        </action>

        <!-- 助记符跳转动作 (0-9) -->
